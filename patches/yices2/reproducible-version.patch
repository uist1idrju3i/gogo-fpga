--- a/utils/make_source_version
+++ b/utils/make_source_version
@@ -60,7 +60,11 @@
 #
 # Date and git commit
 #
-now=`date +"%Y-%m-%d"`
+if test -n "${SOURCE_DATE_EPOCH:-}"; then
+  now=`date -u -d "@$SOURCE_DATE_EPOCH" +"%Y-%m-%d"` || exit 1
+else
+  now=`date +"%Y-%m-%d"`
+fi
 
 #
 # Revision.
@@ -77,6 +81,11 @@
 # this boundary an extracted source archive inside an unrelated work tree can
 # inherit that outer repository's commit. Only then fall back to "unknown".
 #
+script_dir=`CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P`
+if test -z "$YICES_SOURCE_REVISION" && test -f "$script_dir/../.gitcommit"; then
+  YICES_SOURCE_REVISION=`cat "$script_dir/../.gitcommit"`
+fi
+
 if test -n "$YICES_SOURCE_REVISION" ; then
   rev="$YICES_SOURCE_REVISION"
 else
