{
  "id": "design_flow",
  "initial": "editing",
  "states": {
    "build_failed": {
      "description": "\u5931\u6557\u3002\u554f\u984c\u306e\u4e00\u89a7\u3092\u958b\u304d\u3001\u5148\u982d\u306e\u884c\u3078\u79fb\u308c\u308b",
      "entry": [
        "open_problem_list"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "build_requested": [
          {
            "guard": "tools_not_cached",
            "target": "loading_tools"
          },
          {
            "guard": "tools_cached",
            "target": "building"
          }
        ],
        "source_edited": "editing"
      }
    },
    "building": {
      "description": "\u5408\u6210\u30fb\u914d\u7f6e\u914d\u7dda\u30fbpack \u3092\u5b9f\u884c\u4e2d\u3002\u5de5\u7a0b\u3054\u3068\u306b\u9032\u6357",
      "entry": [
        "show_stage_progress"
      ],
      "meta": {
        "surface": "tool_workers"
      },
      "on": {
        "build_cancelled": "editing",
        "build_errored": "build_failed",
        "build_succeeded": "built"
      }
    },
    "built": {
      "description": "\u30d3\u30c3\u30c8\u30b9\u30c8\u30ea\u30fc\u30e0\u304c\u3042\u308a\u3001\u4eca\u306e\u7248\u3068\u4e00\u81f4\u3059\u308b",
      "entry": [
        "show_build_summary"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "source_edited": "stale",
        "write_requested": [
          {
            "guard": "board_idcode_matches",
            "target": "writing"
          }
        ]
      }
    },
    "editing": {
      "description": "\u7de8\u96c6\u4e2d\u3002\u6210\u679c\u7269\u306a\u3057\u3001\u307e\u305f\u306f\u6700\u65b0",
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "build_requested": [
          {
            "guard": "tools_not_cached",
            "target": "loading_tools"
          },
          {
            "guard": "tools_cached",
            "target": "building"
          }
        ],
        "write_requested": [
          {
            "guard": "uploaded_fs_selected && board_idcode_matches",
            "target": "writing"
          }
        ]
      }
    },
    "loading_tools": {
      "description": "\u5408\u6210\u30c4\u30fc\u30eb\u3092\u53d6\u5f97\u4e2d\u3002\u9032\u6357\u3068\u6b8b\u91cf\u3092\u8868\u793a",
      "entry": [
        "show_download_progress"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "download_failed": "build_failed",
        "tools_ready": "building"
      }
    },
    "stale": {
      "description": "\u5408\u6210\u5f8c\u306b\u7de8\u96c6\u3057\u305f\u3002\u66f8\u304d\u8fbc\u3080\u524d\u306b\u5408\u6210\u3057\u76f4\u3059\u3088\u3046\u6848\u5185",
      "entry": [
        "mark_artifacts_stale"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "build_requested": [
          {
            "guard": "tools_not_cached",
            "target": "loading_tools"
          },
          {
            "guard": "tools_cached",
            "target": "building"
          }
        ],
        "write_requested": [
          {
            "actions": [
              "explain_rebuild_needed"
            ],
            "target": "stale"
          }
        ]
      }
    },
    "write_failed": {
      "description": "\u66f8\u304d\u8fbc\u307f\u5931\u6557\u3002\u539f\u56e0\u306e\u5019\u88dc\u3068\u6b21\u306e\u64cd\u4f5c\u3092\u8868\u793a",
      "entry": [
        "show_write_hint"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "write_requested": [
          {
            "guard": "board_idcode_matches",
            "target": "writing"
          }
        ]
      }
    },
    "writing": {
      "description": "\u66f8\u304d\u8fbc\u307f\u4e2d\u3002\u6d88\u53bb\u30fb\u66f8\u304d\u8fbc\u307f\u30fb\u78ba\u8a8d\u306e\u9032\u6357",
      "entry": [
        "show_write_progress"
      ],
      "meta": {
        "surface": "tang_nano"
      },
      "on": {
        "write_errored": "write_failed",
        "write_succeeded": "written"
      }
    },
    "written": {
      "description": "\u66f8\u304d\u8fbc\u307f\u6210\u529f\uff08\u7d42\u4e86\u30b3\u30fc\u30c9\u3068\u30ed\u30b0\u306e\u4e21\u65b9\u3067\u5224\u5b9a\uff09",
      "entry": [
        "show_write_result"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "source_edited": "stale",
        "write_requested": [
          {
            "guard": "board_idcode_matches",
            "target": "writing"
          }
        ]
      }
    }
  }
}
