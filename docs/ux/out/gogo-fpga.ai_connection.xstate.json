{
  "id": "ai_connection",
  "initial": "disconnected",
  "states": {
    "auth_failed": {
      "description": "\u62d2\u5426\u30fb\u671f\u9650\u5207\u308c\u30fbstate \u4e0d\u4e00\u81f4\u3002\u7406\u7531\u3068\u518d\u8a66\u884c",
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "connect_requested": [
          {
            "guard": "consent_given",
            "target": "authorizing"
          }
        ]
      }
    },
    "authorizing": {
      "description": "OpenRouter \u306e\u8a8d\u53ef\u753b\u9762\uff08\u540c\u3058\u30bf\u30d6\u3067\u79fb\u52d5\uff09",
      "meta": {
        "surface": "openrouter"
      },
      "on": {
        "auth_denied": "auth_failed",
        "callback_received": "exchanging"
      }
    },
    "connected": {
      "description": "\u63a5\u7d9a\u6e08\u307f\u3002\u9375\u306e\u4fdd\u5b58\u5148\uff08\u30bf\u30d6\u306e\u307f / \u3053\u306e\u7aef\u672b\uff09\u3092\u8868\u793a",
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "disconnect_requested": [
          {
            "actions": [
              "erase_key"
            ],
            "target": "disconnected"
          }
        ]
      }
    },
    "disconnected": {
      "description": "\u672a\u63a5\u7d9a\u3002\u9001\u308b\u5185\u5bb9\u3068\u4fdd\u5b58\u5148\u3092\u8aac\u660e",
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "connect_requested": [
          {
            "actions": [
              "store_verifier"
            ],
            "guard": "consent_given",
            "target": "authorizing"
          }
        ]
      }
    },
    "exchanging": {
      "description": "state \u3092\u7167\u5408\u3057\u3001code \u3092\u9375\u306b\u4ea4\u63db\u4e2d",
      "entry": [
        "verify_state"
      ],
      "meta": {
        "surface": "web_app"
      },
      "on": {
        "exchange_failed": "auth_failed",
        "key_received": [
          {
            "actions": [
              "discard_verifier"
            ],
            "target": "connected"
          }
        ]
      }
    }
  }
}
